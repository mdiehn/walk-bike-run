{
  "name": "walk-bike-run",
  "version": "0.5.0-dev",
  "private": true,
  "type": "module",
  "description": "A small personal route planner for walking, biking, and running.",
  "scripts": {
    "dev": "node build.js --sync-version && vite --host 0.0.0.0",
    "build": "node build.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:sync": "node build.js --sync-version",
    "pack:repo": "rm ../walk-bike-run.tar.gz && git archive --format=tar.gz --output=../walk-bike-run.tar.gz HEAD",
    "check:all": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}

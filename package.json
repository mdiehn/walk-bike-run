{
  "name": "walk-bike-run",
  "private": true,
  "type": "module",
  "scripts": {
    "version:sync": "node build.js --sync-only",
    "dev": "node build.js --sync-only && vite --host 0.0.0.0",
    "build": "node build.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "leaflet": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "vitest": "latest"
  }
}
